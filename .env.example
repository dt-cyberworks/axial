# Local evaluation: `make env` (run by `make up`) creates .env from this file and
# fills the two empty encryption keys below. Production: generate the whole file
# with scripts/gen_production_env.py instead (INSTALL.md section 4).

# --- control-plane ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://asm:asm@postgres:5432/asm
REDIS_URL=redis://redis:6379/0
# S3-compatible object store (SeaweedFS). These credentials are PUBLIC development
# defaults; production refuses to start with them (use gen_production_env.py).
S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=asm-dev-access
S3_SECRET_KEY=asm-dev-secret-change-me
S3_BUCKET=asm-evidence

# --- LLM provider (the Vector Agent) ---
# OpenAI-COMPATIBLE interface: OpenAI, Eden AI or a local gateway.
# These values are env DEFAULTS; at runtime the console overrides them
# (Settings -> LLM provider, stored in app_setting).
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   Eden AI: LLM_BASE_URL=https://api.edenai.run/v2/openai  LLM_MODEL=<provider/modell>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Secrets (a secrets manager in production; local placeholders only here) ---
SCOPE_SIGNING_SECRET=change-me-in-dev
INTERNAL_API_TOKEN=change-me-in-dev
OPERATOR_API_TOKEN=change-me-in-dev
# REQ-AGENT-027: this environment's real public base URL, embedded in the
# ActiveMQ OpenWire callback link a probed target fetches. Dev default is
# fine as-is; int/prod MUST set this to their real domain
# (https://scan-int.example.com etc) in .env.int/.env.prod.
PUBLIC_BASE_URL=http://localhost:8000
# REQ-HARDEN-001: shared secret between the worker and the tool-runner's
# execution boundary. The runner rejects any request without it (fail-closed).
RUNNER_API_TOKEN=runner-change-me-in-dev
# REQ-IAM-004: Fernet key that encrypts TOTP secrets at rest. NO key ships in
# source, so this stays empty here: `make env` generates one into your .env
# (REQ-INSTALL-003) and keeps it only there (.env is gitignored). Without a key
# nobody can enroll MFA, and the console answers 503 until one is set.
MFA_ENCRYPTION_KEY=
# GitHub issue #25: Fernet key that encrypts LLM/NVD provider API keys at
# rest in app_setting (only keys entered via the Settings GUI - env-var
# fallbacks like LLM_API_KEY above are never written to the database).
# `make env` generates this one too, and always a DIFFERENT key from the MFA
# one - a leak of one must not expose the other secret.
SETTINGS_ENCRYPTION_KEY=
# Optional, comma-separated: old key(s) still accepted for DECRYPTING values
# written before a rotation. Only the (single) SETTINGS_ENCRYPTION_KEY above
# is ever used to encrypt new values.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# --- Worker / Vector Agent ---
# Compose runner profile: availability is still checked against gateway /health.
ASM_RAW_NETWORK_MODE=lease-gateway
RAW_EGRESS_GATEWAY_URL=http://raw-egress-gateway:8765
RAW_EGRESS_QUEUE_WAIT_SECONDS=1800
RAW_EGRESS_QUEUE_POLL_SECONDS=1
RAW_EGRESS_SIGNING_SECRET=raw-egress-change-me-in-dev
# GitHub issue #22: shared secret authenticating the worker/control-plane to
# the raw-egress gateway's reservation/lease HTTP API (separate from the
# lease-verifier RAW_EGRESS_SIGNING_SECRET above). The gateway rejects any
# reservation request without it (fail-closed).
RAW_EGRESS_API_TOKEN=raw-egress-api-change-me-in-dev
RAW_EGRESS_LEASE_TTL_SECONDS=900
RAW_EGRESS_MATERIALIZATION_MAX_AGE_SECONDS=900
NMAP_MAX_RATE=300
# GitHub issue #35: maximum address count a cidr scope asset may cover
# (65536 = a /16 for IPv4). Conservative, order-of-magnitude default - see
# docs/requirements/scope-asset-validation.md.
MAX_HOST_DISCOVERY_ADDRESSES=65536

# Origins a browser console may call the API from (comma-separated). Only the
# development console needs it; the default is http://localhost:5173.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database pool of the control plane (GitHub issue #49). The defaults suit one
# scan with the console open; raise DB_POOL_SIZE only together with Postgres'
# max_connections. INTERNAL_BULK_DB_SLOTS caps how many connections the egress
# proxy's audit and rate-reservation calls may hold at once and must stay below
# DB_POOL_SIZE + DB_MAX_OVERFLOW so cancel checks and the console always get one.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=10
# INTERNAL_BULK_DB_SLOTS=4
ASM_AGENT_MAX_TOKENS=8192
ASM_AGENT_LENGTH_RETRIES=2
ASM_AGENT_RETRY_MAX_TOKENS=8192

# --- egress-proxy ---
PROXY_DATABASE_URL=postgresql+psycopg://asm_proxy_ro:asm-proxy-dev@postgres:5432/asm
EGRESS_PROXY_PORT=3128
EGRESS_MAX_CONCURRENT_CLIENTS=64
CONTROL_PLANE_URL=http://control-plane:8000

# --- Operator console (frontend) ---
VITE_API_BASE_URL=http://localhost:8000
