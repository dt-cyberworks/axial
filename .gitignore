# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# --- Shared edge (multi-environment deploy, REQ-MULTIENV-001) ---
# Each environment's built SPA is copied here at deploy time; only the
# directory structure (.gitkeep) is tracked, never the built assets.
edge-shared/frontend-*/*
!edge-shared/frontend-*/.gitkeep

# --- Env & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Data / Volumes ---
pgdata/
miniodata/
seaweedfsdata/
*.log

# --- OS / Editor ---
.DS_Store
.idea/
.vscode/
*.swp

# Generated bring-up state (benchmark/orchestration/bringup.py) -
# written by up(), removed by down(). Never hand-edited/committed.
benchmark/results/.bringup-state.json
# Output of the removed sweep harness (kept locally as history, never committed):
# hundreds of KB of scan results measured on the altered configuration.
benchmark/results/latest-report.json
benchmark/results/latest-report.md
