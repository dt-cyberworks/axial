# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# --- Shared edge (multi-environment deploy, REQ-MULTIENV-001) ---
# Each environment's built SPA is copied here at deploy time; only the
# directory structure (.gitkeep) is tracked, never the built assets.
edge-shared/frontend-*/*
!edge-shared/frontend-*/.gitkeep

# --- Env & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Data / Volumes ---
pgdata/
miniodata/
*.log

# --- OS / Editor ---
.DS_Store
.idea/
.vscode/
*.swp

# Generated per-run benchmark sweep state (benchmark/orchestration/sweep.py) -
# regenerated by up()/seed(), removed by down(). Never hand-edited/committed.
benchmark/orchestration/generated-run-aliases-override.yml
benchmark/results/.sweep-state.json
# Generated sweep output (lifecycle.report()) - regenerated by every run and
# hundreds of KB of scan results; the ground truth is committed, the run
# output is not.
benchmark/results/latest-report.json
benchmark/results/latest-report.md
